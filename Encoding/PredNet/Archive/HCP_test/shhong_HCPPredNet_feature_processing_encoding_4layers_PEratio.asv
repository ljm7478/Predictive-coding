                W = load([saveroot,'/', 'ratio', '/', '6layers', '/', 'W','/',  sprintf('seg%d',seg), '/', num2str(subject), '_', sprintf('layer%d_seg%d', layer, seg), '_W_svd0.9.mat']);
                W = W.W;
                
                % prediction
                concat_data = ratio.(sprintf('layer%d_seg%d', layer, seg));
                name= sprintf('layer%d_seg%d', layer, seg)
                concat_data_dim = size(concat_data)
                
                prediction_data = concatenated.(sprintf('%s%d_seg%d', features{1}, layer, seg));
                pre_dim=size(prediction_data)
                
                %segmentation into each prediction for each layer + seg
                pre_W = W(1:pre_dim(2),:);
                
                %pre_Yhat make
                pre_Yhat = prediction_data * pre_W;
                
                name = [num2str(subject), '_', sprintf('Ahat%d_seg%d', layer, seg), '_W_svd0.9.mat']
                save([prediction_folder_name,'/', name], 'pre_Yhat', '-v7.3');
                
                % Error
                %segmentation into each error for each layer + seg
                err_W = W((pre_dim(2)+1:end),:);
                
                error_data = concatenated.(sprintf('%s%d_seg%d', features{2}, layer, seg));
                err_dim=size(error_data)
                
                %pre_error make
                pre_Error = error_data * err_W;
                
                name = [num2str(subject), '_', sprintf('E%d_seg%d', layer, seg), '_W_svd0.9.mat']
                save([error_folder_name,'/', name], 'pre_Error', '-v7.3');
            end
        end
    end
end

        
%% load fMRI Y
clc;clear

%load Y
saveroot = '/combinelab/03_user/jungmin/01_project/01_Encoding/01_HWen_Encoding/PredNet/Titanic_trained/HCP_test';
load([saveroot, '/' , 'Y', '/', 'fMRI_10k_cortex.mat']);

%% ratio map calculation - total movie
clc; 

%dir
saveroot = '/combinelab/03_user/jungmin/01_project/01_Encoding/01_HWen_Encoding/PredNet/Titanic_trained/HCP_test';

subjectIDs = [100610, 116726, 135124, 156334, 169343, 178243, 191841, 201515, 249947, 380036, 463040, 725751, 818859, 901139, 102311, 118225, 137128, 157336, 169444, 178647, 192439, 203418, 251833, 381038, 467351, 601127, 732243, 825048, 901442, 995174, 102816, 125525, 140117, 158035, 169747, 180533, 192641, 204521, 257845, 385046, 617748, 826353, 905147, 104416, 126426, 144226, 158136, 171633, 181232, 193845, 205220, 263436, 389357, 525541, 627549, 751550, 833249, 910241, 105923, 145834, 159239, 172130, 195041, 209228, 283543, 393247, 638049, 757764, 859671, 926862, 108323, 128935, 146129, 162935, 173334, 182436, 196144, 212419, 318637, 395756, 541943, 644246, 765864, 861456, 927359, 109123, 130114, 146432, 164131, 175237, 182739, 197348, 214019, 320826, 397760, 547046, 654552, 770352, 871762, 942658, 111312, 130518, 146735, 164636, 176542, 185442, 198653, 214524, 330324, 401422, 671855, 771354, 872764, 943862, 111514, 131722, 146937, 165436, 177140, 186949, 199655, 221319, 346137, 406836, 562345, 680957, 782561, 878776, 951457, 114823, 132118, 148133, 167036, 177645, 187345, 200210, 233326, 352738, 412528, 572045, 690152, 783462, 878877, 958976, 115017, 134627, 150423, 167440, 177746, 191033, 200311, 239136, 360030, 429040, 573249, 706040, 789373, 898176, 966975, 115825, 134829, 155938, 169040, 178142, 191336, 200614, 246133, 365343, 436845, 581450, 724446, 814649, 899885, 971160];

features = {'Ahat','E'};

PT_layer_array={};
ET_layer_array={};
PE_layer_array={};


P_seg_array={};
E_seg_array={};
PE_seg_array={};


for i = 1:15
    subject = subjectIDs(i) 
    disp(['correalting' , num2str(subject)])
    
    % total Y
    sub_cii1_4 = cat(2, sub_cii{i}{1}, sub_cii{i}{2}, sub_cii{i}{3}, sub_cii{i}{4});
    dim = size(sub_cii1_4)
    
    for layer= 0:5
        for seg = 1:4
            % Initialize arrays to store results
            num_voxels = dim(1);
            
            %load Yhat_prediction
            prediction_folder_name = [saveroot,'/', 'ratio','/', '6layers', '/', 'Yhat', '/', 'Y_hat_P','/', sprintf('seg%d',seg),'/']
            pre_Yhat = load([prediction_folder_name,'/', num2str(subject), '_', sprintf('Ahat%d_seg%d', layer, seg), '_W_svd0.9.mat'])
            P_seg_array{seg}= pre_Yhat.pre_Yhat;
            

            %load Yhat_error
            error_folder_name = [saveroot,'/', 'ratio','/', '6layers', '/', 'Yhat', '/','Y_hat_E','/', sprintf('seg%d',seg),'/']
            pre_Error = load([error_folder_name,'/', num2str(subject), '_', sprintf('E%d_seg%d', layer, seg), '_W_svd0.9.mat'])
            E_seg_array{seg}=pre_Error.pre_Error;
           
            
            %load total prediction+error
            total_folder_name = [saveroot,'/', 'ratio','/', '6layers', '/', 'Yhat', '/', 'Y_hat_P+E','/', sprintf('seg%d',seg),'/']
            pre_total = load([total_folder_name,'/', num2str(subject), '_', sprintf('layer%d_seg%d', layer, seg), '_pred_svd0.90.mat'])
            PE_seg_array{seg}=pre_total.Yhat;
           
        end
        
        %concatenat Yhat for movie1-4
        pre_Yhat_total= cat(1, P_seg_array{:});
        pre_Error_total= cat(1, E_seg_array{:});
        pre_total_total= cat(1, PE_seg_array{:});
        
        
        % linear regression calc begins
        PT_array = zeros(1, num_voxels);
        ET_array = zeros(1, num_voxels);
        PE_array = zeros(1, num_voxels);
        
        for v = 1:num_voxels
            
            % Fit a linear regression model for the total prediction+error data for the current voxel
            mdl_total = fitlm(pre_total_total(v), sub_cii1_4(v));
            
            % Fit a linear regression model for the prediction data for the current voxel
            mdl_prediction = fitlm(pre_Yhat_total(v), sub_cii1_4(v));
            
            % Fit a linear regression model for the error data for the current voxel
            mdl_error = fitlm(pre_Error_total(v), sub_cii1_4(v));
            
            if  mdl_prediction.Coefficients.Estimate(1) ~= 0 && mdl_error.Coefficients.Estimate(1) ~= 0
                PE = mdl_prediction.Coefficients.Estimate(1) / mdl_error.Coefficients.Estimate(1);
            elseif mdl_prediction.Coefficients.Estimate(2) ~= 0 && mdl_error.Coefficients.Estimate(2) ~= 0
                PE = mdl_prediction.Coefficients.Estimate(2) / mdl_error.Coefficients.Estimate(2);
            end
            
            if mdl_total.Coefficients.Estimate(1) ~= 0 && mdl_error.Coefficients.Estimate(1) ~= 0
                ET = mdl_error.Coefficients.Estimate(1) / mdl_total.Coefficients.Estimate(1);
            elseif mdl_total.Coefficients.Estimate(2) ~= 0 && mdl_error.Coefficients.Estimate(2) ~= 0
                ET = mdl_error.Coefficients.Estimate(2) / mdl_total.Coefficients.Estimate(2);
            end
            
            if mdl_total.Coefficients.Estimate(1) ~= 0 && mdl_prediction.Coefficients.Estimate(1) ~= 0
                PT = mdl_prediction.Coefficients.Estimate(1) / mdl_total.Coefficients.Estimate(1);
            elseif mdl_total.Coefficients.Estimate(2) ~= 0 && mdl_prediction.Coefficients.Estimate(2) ~= 0
                PT = mdl_prediction.Coefficients.Estimate(2) / mdl_total.Coefficients.Estimate(2);
            end
            
            % Store the calculated ratios in the arrays
            PT_array(v) = PT;
            ET_array(v) = ET;
            PE_array(v) = PE;
        end
        % Concatenate ratio for each layer
        PT_layer_array{layer+1} = PT_array;
        ET_layer_array{layer+1} = ET_array;
        PE_layer_array{layer+1} = PE_array;
    end
    
    %save layer_array for each subject
    PT_layer_array = cat(1, PT_layer_array{:});
    PT_name = [num2str(subject), '_PT_ratio.mat']
    save([saveroot,'/', 'ratio','/', '6layers', '/', 'ratio_map', '/', 'PT','/', PT_name], 'PT_layer_array', '-v7.3');
    
    ET_layer_array = cat(1, ET_layer_array{:});
    ET_name = [num2str(subject), '_ET_ratio.mat']
    save([saveroot,'/', 'ratio','/', '6layers', '/', 'ratio_map', '/', 'ET','/', ET_name], 'ET_layer_array', '-v7.3');
    
    PE_layer_array = cat(1, PE_layer_array{:});
    PE_name = [num2str(subject), '_PE_ratio.mat']
    save([saveroot,'/', 'ratio','/', '6layers', '/', 'ratio_map', '/', 'PE','/', PE_name], 'PE_layer_array', '-v7.3');
    
    %initialize
    PT_layer_array={};
    ET_layer_array={};
    PE_layer_array={};
end


