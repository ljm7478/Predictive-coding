        for layer= 0:5
            for seg = 1:4
                %folder
                prediction_folder_name = [saveroot,'/', 'ratio','/', '6layers', '/', 'Y_hat_P','/', sprintf('seg%d',seg),'/']
                if not(exist(prediction_folder_name,'dir'))
                    mkdir(prediction_folder_name)
                end
                
                error_folder_name = [saveroot,'/', 'ratio','/', '6layers', '/', 'Y_hat_E','/', sprintf('seg%d',seg),'/']
